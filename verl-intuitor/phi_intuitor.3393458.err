module() {
   local _mlredir=0;
   if [ -n "${MODULES_REDIRECT_OUTPUT+x}" ]; then
      if [ "$MODULES_REDIRECT_OUTPUT" = '\''0'\'' ]; then
         _mlredir=0;
      elif [ "$MODULES_REDIRECT_OUTPUT" = '\''1'\'' ]; then
         _mlredir=1;
      fi;
   fi;
   case " $@ " in
      *'\'' --no-redirect '\''*) _mlredir=0 ;;
      *'\'' --redirect '\''*) _mlredir=1 ;;
   esac;
   if [ $_mlredir -eq 0 ]; then
      _module_raw "$@";
   else
      _module_raw "$@" 2>&1;
   fi;
};
