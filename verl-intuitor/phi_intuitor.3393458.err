+++++ get_cluster_name
+++++ local CURRENT_CONFIGFILE=/etc/cluster_config/config.xml
+++++ local 'REGEX_CURRENT_CONFIGFILE=^--config=(.*)$'
+++++ [[ 0 -ne 0 ]]
+++++ local CLUSTER_NAME
++++++ cat_xml_with_xinclude /etc/cluster_config/config.xml
++++++ [[ 1 -eq 0 ]]
++++++ xmllint --xinclude --xmlout /etc/cluster_config/config.xml
++++++ /usr/bin/xmlstarlet sel --template --value-of /config/cluster_name
+++++ CLUSTER_NAME=hk
+++++ [[ -n hk ]]
+++++ echo hk
+++++ return 0
++++ export CLUSTER=hk
++++ CLUSTER=hk
++++ debug_echo 'CLUSTER="hk"'
++++ [[ -n '' ]]
++++ DIRECTORY=/etc/profile.d/KITE
++++ REST=/hk-project-p0022560/hgf_teb8892/
++++ [[ -n /hk-project-p0022560/hgf_teb8892/ ]]
++++ DIRECTORY+=/
++++ REST=hk-project-p0022560/hgf_teb8892/
++++ [[ ! -d /etc/profile.d/KITE/ ]]
++++ for SCRIPT in "${DIRECTORY}"*.sh
++++ [[ -r /etc/profile.d/KITE/bash_settings.sh ]]
++++ debug_echo 'Sourcing "/etc/profile.d/KITE/bash_settings.sh".'
++++ [[ -n '' ]]
++++ source /etc/profile.d/KITE/bash_settings.sh
+++++ declare -x 'HISTTIMEFORMAT=%F %T '
+++++ unset HISTCONTROL
